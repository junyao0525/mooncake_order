# ------------------------------------------------------------------
# Copy this file to .env and fill in real values.
#   cp .env.example .env
# Use .env (not .env.local): the Prisma CLI only auto-loads .env, while
# Next.js loads both — so one .env keeps app and `db:push` in sync.
# Never commit .env — it holds secrets (.gitignore already covers .env*).
# ------------------------------------------------------------------

# Postgres connection string (from Vercel → Storage → your Postgres DB,
# or from Neon). Use the POOLED connection string (host contains "-pooler").
DATABASE_URL="postgresql://user:password@host-pooler.neon.tech/dbname?sslmode=require"

# The same Neon database, but the UNPOOLED (direct) connection string.
# Only used by `prisma db push` / `prisma migrate`, which run DDL that
# PgBouncer cannot handle. REQUIRED — every Prisma command fails if it is unset
# or empty. If your DB is not pooled, just repeat the DATABASE_URL value here.
DIRECT_URL="postgresql://user:password@host.neon.tech/dbname?sslmode=require"

# Admin login for the /dashboard. Choose your own email + strong password.
ADMIN_EMAIL="admin@angelbakery.com"
ADMIN_PASSWORD="change-me-to-a-strong-password"

# Secret used to sign session cookies. Generate one with:
#   openssl rand -base64 32
AUTH_SECRET="generate-a-random-32-byte-string"
